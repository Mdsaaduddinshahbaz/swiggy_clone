.orders-container {
    max-width: 800px;
    margin: auto;
    padding: 20px;
    font-family: Arial, sans-serif;
}
body{
        background: #381042;
}
.order-card {
    border: 1px solid #ddd;
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 20px;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.token-no{
    margin-bottom: 10px;
    font-weight: 700;
}
.order-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
}

.order-id {
    font-weight: bold;
    overflow-wrap: break-word;
    word-break: break-word;
}

.order-status {
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 12px;
    height: fit-content;
}

.status-placed { background: orange; color: white; }
.status-preparing { background: blue; color: white; }
.status-completed { background: green; color: white; }
.status-canceled { background: rgb(255, 0, 0); color: white; }

.restaurant-name {
    font-weight: bold;
    margin-top: 10px;
}

.item {
    display: flex;
    justify-content: space-between;
    margin: 5px 0;
}

.total {
    text-align: right;
    font-weight: bold;
    margin-top: 10px;
}
h1{
    color: white;
}

.header {
    display: flex;
    justify-content: space-between;  /* 🔥 pushes button to right */
    align-items: center;
}

#filterDropdown {
    padding: 6px 10px;
    border-radius: 6px;
    cursor: pointer;
}
.res_namesss{
        display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
}



/*orders*/

.empty-state{
    visibility: hidden;
    position: absolute;
    width:100%;
    max-width:500px;
    background:#fff;
    border-radius:24px;
    padding:50px 40px;
    text-align:center;
    /* box-shadow:0 10px 40px rgba(0,0,0,0.08); */
    /* transition:0.3s; */
        align-self: center;
    justify-self: center;
    background: #3d4152;
}
.empty-state.show{
    visibility: visible;
    position: relative;
}

/* .empty-state.show .btn{

} */
.empty-state:hover{
    transform:translateY(-4px);
}

.icon{
    width:120px;
    height:120px;
    margin:0 auto 24px;
    background:#eef2ff;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:60px;
}

h1{
    font-size:28px;
    color:white;
    margin-bottom:12px;
}

p{
    color:#6b7280;
    font-size:16px;
    line-height:1.6;
    margin-bottom:30px;
}

.btn{
    border:none;
    background:#4f46e5;
    color:white;
    padding:14px 28px;
    border-radius:12px;
    font-size:16px;
    font-weight:600;
    cursor:pointer;
    /* transition:0.3s; */
}

.btn:hover{
    background:#4338ca;
    transform:translateY(-2px);
}

.secondary-link{
    display:block;
    margin-top:18px;
    color:#4f46e5;
    text-decoration:none;
    font-weight:500;
}

.secondary-link:hover{
    text-decoration:underline;
}

@media(max-width:480px){
    .empty-state{
        padding:40px 25px;
    }

    h1{
        font-size:24px;
    }
}
@media (max-width:595px) {
    body{
        overflow-x: clip;
    }
}
@media (max-width:240px) {
    .header{
        display: block;
    }
}